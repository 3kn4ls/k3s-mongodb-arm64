apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secret
  namespace: mongodb
type: Opaque
stringData:
  # IMPORTANTE: Cambiar estos valores antes de desplegar
  # El usuario por defecto es 'admin' y la contraseña 'changeme'
  # Para producción, usar contraseñas fuertes
  username: admin
  password: changeme
  # Formato de conexión: mongodb://username:password@mongodb-service:27017
  connection-string: mongodb://admin:changeme@mongodb-service.mongodb.svc.cluster.local:27017
